# Backboard API credentials
# The Backboard API Key for running Gemma 4 model inference
BACKBOARD_API_KEY=""

# Backboard API Base URL (default is https://app.backboard.io/api)
BACKBOARD_BASE_URL="https://app.backboard.io/api"

# LLM Provider on Backboard (e.g. google, anthropic, openai)
BACKBOARD_LLM_PROVIDER="google"

# LLM Model Name on Backboard (default: gemma-4)
BACKBOARD_MODEL_NAME="gemma-4"

# Cache Time-To-Live in days for recommendations and university details (default: 7)
CACHE_TTL_DAYS=7

# Upstash Redis REST credentials (optional; in-memory fallback is active if omitted)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Gemini API Key (Secondary fallback provider if Backboard is unreachable)
GEMINI_API_KEY=""

# Application Host URL
APP_URL="http://localhost:3000"
